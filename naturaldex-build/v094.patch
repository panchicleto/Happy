 	private static bool AuditInsertedSlots(SaveFile sav, List<(int Slot, PKM Pokemon)> plan, bool strict, bool strictTrainer, out string reason)
 	{
+		var identities = new HashSet<(uint PID, uint EC)>();
 		foreach (var entry in plan)
 		{
 			PKM stored = sav.GetBoxSlotAtIndex(entry.Slot);
+			if (!identities.Add((stored.PID, stored.EncryptionConstant)))
+			{
+				reason = $"Slot {entry.Slot}: PID+EC duplicado accidentalmente dentro del lote.";
+				return false;
+			}
